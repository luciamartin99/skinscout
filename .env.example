# Copy this file to .env.local for local development (never commit .env.local -
# it's already in .gitignore). In production, set these in Vercel -> Project ->
# Settings -> Environment Variables instead. For the one-off import script in
# scripts/import-obf-sample.mjs, set them as GitHub Actions repository secrets
# instead (see .github/workflows/import-obf-sample.yml) - never paste them
# into chat or commit real values anywhere.

# ---------------------------------------------------------------------------
# AI (already in use by api/generate-report.js and api/ask.js)
# ---------------------------------------------------------------------------
# Server-side only. Without it, those routes return a mocked response.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase - frontend (safe to expose to the browser)
# ---------------------------------------------------------------------------
# From Supabase -> Project Settings -> API.
# Vite injects VITE_-prefixed vars into the frontend bundle. Row Level
# Security policies are what keep this safe - the anon key can only do what
# our RLS policies allow (currently: public read-only access to catalog
# tables, no writes).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase - server-side only (Node scripts, serverless functions)
# ---------------------------------------------------------------------------
# Same Project URL as above, just without the VITE_ prefix so plain Node
# scripts (process.env, not import.meta.env) can read it too. Not secret by
# itself, but keep it out of frontend code paths for clarity.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# NEVER prefix this with VITE_, never send it to the browser, never log it.
# Bypasses Row Level Security entirely. Only used by scripts/import-obf-sample.mjs
# and other future admin/import tooling - not by the frontend.
SUPABASE_SERVICE_ROLE_KEY=
