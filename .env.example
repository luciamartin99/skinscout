# Copy this file to .env.local for local development (never commit .env.local -
# it's already in .gitignore). In production, set these in Vercel -> Project ->
# Settings -> Environment Variables instead.

# ---------------------------------------------------------------------------
# AI (already in use by api/generate-report.js and api/ask.js)
# ---------------------------------------------------------------------------
# Server-side only. Without it, those routes return a mocked response.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (Phase B - schema only for now, nothing connects to this yet)
# ---------------------------------------------------------------------------
# From Supabase -> Project Settings -> API.

# Safe to expose to the browser (Vite injects VITE_-prefixed vars into the
# frontend bundle). Row Level Security policies are what keep this safe -
# the anon key can only do what our RLS policies allow (currently: public
# read-only access to catalog tables, no writes).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only - NEVER prefix this with VITE_, never send it to the
# browser, never log it. Bypasses Row Level Security entirely. Only used by
# future admin/import scripts and privileged serverless functions (e.g. the
# Open Beauty Facts import job), not by the frontend.
SUPABASE_SERVICE_ROLE_KEY=
